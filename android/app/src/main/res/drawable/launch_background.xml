<?xml version="1.0" encoding="utf-8"?>
<!-- Splash shown while Flutter starts. Uses the vector foreground directly:
     referencing @mipmap/ic_launcher inside a <bitmap> crashes on Android 8+
     because that resource is an adaptive icon, not a bitmap. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_bg"/>
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center"
        android:width="192dp"
        android:height="192dp"/>
</layer-list>
